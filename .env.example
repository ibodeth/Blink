# ---------------------------------------------------------------------------
# Blink configuration example. Copy to `.env` and fill in your values.
# NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# Required: your OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Model used for command generation.
OPENROUTER_MODEL=openrouter/auto

# --- Server -----------------------------------------------------------------
BLINK_HOST=127.0.0.1
BLINK_PORT=8000
# Set to 1 to run only the API server (Docker / headless).
BLINK_HEADLESS=0

# --- Security ---------------------------------------------------------------
# Disabled by default. When 1, the AI may execute generated shell/Python
# commands (subject to the denylist in src/system.py). Enable at your own risk.
BLINK_ENABLE_CODE_EXECUTION=0
# Max seconds any generated command may run.
BLINK_COMMAND_TIMEOUT=10
# Token required for privileged WebSocket actions. Leave blank to auto-generate
# a per-process token (recommended to pin one when exposing the server).
BLINK_WS_TOKEN=
# Comma-separated CORS / WebSocket origins allowed to connect.
BLINK_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# --- Logging ----------------------------------------------------------------
BLINK_LOG_LEVEL=INFO
# Set to 1 to emit JSON-structured logs (recommended in containers).
BLINK_LOG_JSON=0
